prefix=${pcfiledir}/@SLATEC_PC_PREFIX@
libdir=${prefix}/@SLATEC_PC_LIBDIR@
includedir=${prefix}/@SLATEC_PC_INCLUDEDIR@

Name: SLATEC
Description: SLATEC Common Mathematical Library
Version: @PROJECT_VERSION@
Requires.private: @SLATEC_PC_REQUIRES_PRIVATE@
Cflags: -I${includedir}
Libs: -L${libdir} -lslatec
Libs.private: @SLATEC_PC_LIBS_PRIVATE@
